{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "${mod_authors}"
  ],
  "contact": {
    "sources": "${mod_github}"
  },
  "license": "${mod_license}",
  "icon": "icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "io.github.mortuusars.mortaar.fabric.MortaarFabric"
    ],
    "client": [
      "io.github.mortuusars.mortaar.fabric.MortaarFabricClient"
    ]
  },
  "mixins": [
    "${mod_id}-fabric.mixins.json",
    "${mod_id}-common.mixins.json"
  ],
  "depends": {
    "minecraft": ["${fabric_supported_minecraft_versions}"],
    "fabric-api": "*",
    "forgeconfigapiport": ">=${required_forge_config_api_port_version}"
  }
}